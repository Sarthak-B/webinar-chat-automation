# Copy to .env for running on your own laptop:  npm run agent:local
ZOOM_JOIN_URL=https://us06web.zoom.us/j/XXXXXXXXXXX?pwd=XXXX
ZOOM_SESSION_FILE=zoom-session.json
SHEET_ID=the-long-id-from-the-sheet-url
# Webinar History sheet (Summary / Q&A / Leads). Leave empty to write those tabs into the main sheet.
HISTORY_SHEET_ID=
# Leave empty to be asked which tab when it starts
SCHEDULE_TAB=
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ... paste the whole JSON on one line ...}
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
AGENT_NAME=FlexiFunnels Team
PERSONA_NAME=Saurabh Sir
TEAM_NAMES=Arman,Support Agent
DRY_RUN=true
HEADLESS=false

# Mode for local runs (the dashboard sets these per launch on GitHub)
AUTO_REPLY=true

# ---- Optional tuning (defaults shown; remove the # to change) ----
# Voice + pacing
# HUMANIZE=true
# MAX_PRIVATE_PER_MIN=6
# MAX_ASKS_PER_MIN=2
# SEND_GAP_MS=2500
# ATTENDEE_COOLDOWN_SEC=45
# Number collection
# NUMBER_NUDGES=false   # true = also ask people who only chat ("yes", "1") for their number
# NUDGE_AFTER_MESSAGES=2
# NUDGE_MAX=2
# NUDGE_GAP_MIN=20
# SOCIAL_PROOF_EVERY_MIN=12
# Objections
# OBJECTION_THRESHOLD=3
# OBJECTION_COOLDOWN_MIN=15
# Timing
# JOIN_EARLY_MIN=5
# LATE_GRACE_SEC=90
# END_AFTER_LAST_MIN=10
# MAX_RUNTIME_MIN=340
# AI_CONCURRENCY=4
# Sheet tab names
# REPLIES_TAB=Attendee Replies
# OBJECTIONS_TAB=Objection Handling
# NUMBER_BANK_TAB=Number Drop Bank
# LOG_TAB=Agent Log
# NUMBERS_TAB=Numbers
